#!/usr/bin/env bash
# Machin : commande unique d'accès aux binaires de MachinCast (https://github.com/dascritch/machincast/issues/6).
#
#   Machin [--config FICHIER] BINAIRE [OPTIONS…]   appelle Machin_BINAIRE en lui transmettant les options
#   Machin logs [OPTIONS DE journalctl…]           suit en direct le journal du service de lecture
#   Machin dev                                      sous-shell de développement, venv activé
#   Machin dev-test [--scenarios NOM…]              lance les outils de vérification, avec un bilan
#   Machin dev-screenshots [REPERTOIRE]                refait les captures d'écran du guide de l'antenne
#
# Règles : doc/fr/regles/wrapper.md. Tests : bats tests/wrapper.

set -euo pipefail

# Messages en anglais, traduits dans la langue de la session (https://github.com/dascritch/machincast/issues/360).
# Sans commande externe : le wrapper signale encore une commande manquante dans un PATH réduit à bash.
WRAPPER="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
REPERTOIRE_DU_WRAPPER="${WRAPPER%/*}"
[[ "${REPERTOIRE_DU_WRAPPER}" != "${WRAPPER}" ]] || REPERTOIRE_DU_WRAPPER=.
# shellcheck source=bin/i18n.bash
. "${REPERTOIRE_DU_WRAPPER}/i18n.bash"
charger_messages "${REPERTOIRE_DU_WRAPPER}/.."

# Binaires connus, dans l'ordre de l'aide. Un test vérifie qu'ils correspondent à [project.scripts] de pyproject.toml.
BINAIRES=(player indexer interface maintenance-db purge)
UNITE_LECTURE="machincast.service"

CODE_USAGE=2
CODE_INTROUVABLE=127

aide_minimale() {
	local liste
	liste="$(printf '%s, ' "${BINAIRES[@]}")"
	tf 'Usage: Machin [--config FILE] BINARY [OPTIONS…]  or  Machin logs|dev|dev-test|dev-screenshots
Binaries: %s. Full help: Machin --help
' "${liste%, }"
}

aide_complete() {
	tf 'Machin — single command to reach the MachinCast binaries.

Usage:
  Machin [--config FILE] BINARY [OPTIONS…]
  Machin logs [journalctl OPTIONS…]
  Machin dev | dev-test [--scenarios NAME…] | dev-screenshots [DIRECTORY]
  Machin -h | --help | --binaries

Binaries (Machin BINARY calls Machin_BINARY with the options that follow,
taken from the .venv venv of the project, without it being activated, or else from the PATH):
  player       on-air broadcast, normally launched as a systemd service
  indexer      check of the sound files and update of the database
  interface    graphical programming interface
  maintenance-db
               backs up, checks and optimises the database
               (https://github.com/dascritch/machincast/issues/127)
  purge        erases from the database what exceeds the expiry duration: old
               plays of the airplay, lines of the log, deleted elements; never a
               file (https://github.com/dascritch/machincast/issues/268)

  Help of a binary: Machin BINARY --help

Following the logs:
  logs         follows live the log of the %s service (journalctl --follow).
               The options that follow are passed to journalctl, for instance:
               Machin logs --since "1 hour ago" --priority=warning
               Reading this log requires belonging to the adm or systemd-journal group:
               install.sh adds the account that installs it.

Development (computer installed by ./install.sh --dev):
  dev          opens a subshell in the MachinCast directory, venv activated, with
               the prompt “(MachinCast dev)”; exit leaves it
  dev-test     runs ruff check, ruff format --check, mypy --strict, shellcheck, pytest
               then bats, all even after a failure, with the tools of the venv without it
               being activated; shows a summary per tool and ends in failure if one
               of them fails. A missing tool is reported: ./install.sh --dev installs it.
               With --scenarios NAME…, the same checks, but pytest runs only the
               scenarios of these features (streams, streams.feature or
               tests/features/streams.feature), with those of the style, the catalogues
               and the documentation; bats runs only for the name wrapper. The full run
               is for the tests and code review ticket.
  dev-screenshots redoes the screenshots of the on-air guide, in doc/fr/captures
               or in DIRECTORY: the interface off screen, on a demonstration
               written in the test database, never in the production one.

Wrapper options:
  --config FILE, --config=FILE
               TOML configuration file passed to the binary
               (by default, the binary reads machincast.toml in the MachinCast directory:
               %s/machincast.toml)
  -h           minimal help
  --help       this full help
  --binaries   list of the binaries, one per line (used by the autocompletion)

Examples:
  Machin player --config essai.toml
  Machin indexer --help
  Machin logs
  Machin dev-test
  Machin dev-test --scenarios streams feed_card

Exit codes:
  the one of the called binary, of journalctl for logs, or of the subshell for dev;
  1            dev-test: at least one tool failed or is missing;
  %s            incorrect call of the wrapper (unknown binary or option);
  %s          binary, journalctl or venv not found.

Documentation: https://github.com/dascritch/machincast/blob/main/doc/fr/spec.md#7-wrapper-machin
' "${UNITE_LECTURE}" "$(projet)" "${CODE_USAGE}" "${CODE_INTROUVABLE}"
}

erreur_usage() {
	tf 'Machin: %s\n' "$1" >&2
	aide_minimale >&2
	exit "${CODE_USAGE}"
}

# Répertoire de MachinCast : le parent du répertoire bin/ où se trouve le wrapper. Le lien symbolique éventuel
# (par exemple /usr/local/bin/Machin) est résolu pour trouver le vrai projet. Les binaires y lisent machincast.toml
# par défaut (https://github.com/dascritch/machincast/issues/76).
projet() {
	local wrapper
	wrapper="$(readlink -f "${BASH_SOURCE[0]}")"
	dirname "$(dirname "${wrapper}")"
}

# Venv du projet : .venv à la racine du projet.
venv_du_projet() {
	printf '%s/.venv\n' "$(projet)"
}

# Chemin de Machin_$1 : d'abord dans le venv du projet, sans qu'il soit activé, sinon dans le PATH.
trouver_binaire() {
	local nom="Machin_$1" venv
	venv="$(venv_du_projet)"
	if [[ -x "${venv}/bin/${nom}" ]]; then
		printf '%s\n' "${venv}/bin/${nom}"
	else
		command -v "${nom}"
	fi
}

est_binaire() {
	local binaire
	for binaire in "${BINAIRES[@]}"; do
		[[ "${binaire}" == "$1" ]] && return 0
	done
	return 1
}

suivre_logs() {
	if ! command -v journalctl >/dev/null; then
		tf 'Machin: journalctl not found: the logs of the service are read in the systemd journal\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi
	exec journalctl --unit="${UNITE_LECTURE}" --follow "$@"
}

# Venv du projet, ou arrêt avec le code 127 et la façon de l'installer.
exiger_venv() {
	local venv
	venv="$(venv_du_projet)"
	if [[ ! -r "${venv}/bin/activate" ]]; then
		tf 'Machin: venv not found: %s\n' "${venv}" >&2
		tf '         Install the development computer: ./install.sh --dev\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi
	printf '%s\n' "${venv}"
}

# Sous-shell de développement (https://github.com/dascritch/machincast/issues/77). Un programme ne peut pas activer
# le venv du shell qui l'a lancé : d'où un nouveau shell interactif, qui lit le .bashrc du compte, puis active le
# venv et signale son invite. Son fichier de démarrage s'efface dès qu'il est lu.
ouvrir_dev() {
	local venv demarrage
	venv="$(exiger_venv)"
	demarrage="$(mktemp "${TMPDIR:-/tmp}/machincast-dev.XXXXXX")"
	{
		# fichier de MachinCast : le fichier de démarrage du sous-shell, effacé dès qu'il est lu
		printf 'rm -f -- %q\n' "${demarrage}"
		# shellcheck disable=SC2016
		printf '%s\n' '[[ -r ~/.bashrc ]] && . ~/.bashrc'
		printf '. %q\n' "${venv}/bin/activate"
		printf 'export MACHINCAST_DEV=1\n'
		# shellcheck disable=SC2016
		printf '%s\n' 'PS1="(MachinCast dev) ${PS1-\$ }"'
	} >"${demarrage}"
	cd "$(projet)"
	exec bash --rcfile "${demarrage}" -i
}

# Lance un outil de vérification et note son résultat dans BILAN et ECHOUES. $1 : libellé ; $2 : venv ou PATH,
# où chercher l'outil ; $3 : outil ; la suite : ses arguments.
verifier_avec() {
	local libelle="$1" ou="$2" outil="$3" chemin="" code
	shift 3
	printf '\n==> %s\n' "${libelle}"
	if [[ "${ou}" == venv ]]; then
		[[ -x "${VIRTUAL_ENV}/bin/${outil}" ]] && chemin="${VIRTUAL_ENV}/bin/${outil}"
	else
		chemin="$(command -v "${outil}" || true)"
	fi
	if [[ -z "${chemin}" ]]; then
		tf 'Machin: %s not found: install the development tools with ./install.sh --dev\n' "${outil}" >&2
		BILAN+=("$(tf '%-22s missing' "${libelle}")")
		ECHOUES+=("${libelle}")
		return
	fi
	if "${chemin}" "$@"; then
		BILAN+=("$(tf '%-22s passed' "${libelle}")")
	else
		code=$?
		BILAN+=("$(tf '%-22s failed (code %s)' "${libelle}" "${code}")")
		ECHOUES+=("${libelle}")
	fi
}

# Vérifications du poste de développement (https://github.com/dascritch/machincast/issues/77) : les commandes de la
# section « Qualité » et « Tests » de CLAUDE.md, toutes lancées même après un échec.
# Scénarios toujours lancés avec --scenarios : le style, les catalogues de traduction et la documentation, que tout
# ticket peut casser, en une dizaine de secondes (https://github.com/dascritch/machincast/issues/408).
TOUJOURS=(tests/test_base.py tests/test_language.py tests/test_documentation.py tests/test_guide.py)

# Module de test d'une fonctionnalité : streams, streams.feature ou tests/features/streams.feature donnent celui qui
# appelle scenarios("streams.feature"). Échec pour une fonctionnalité inconnue.
module_de() {
	local nom="${1##*/}" module
	nom="${nom%.feature}"
	for module in tests/test_*.py; do
		if grep -qF "scenarios(\"${nom}.feature\")" "${module}"; then
			printf '%s\n' "${module}"
			return 0
		fi
	done
	return 1
}

# Les modules de pytest pour dev-test --scenarios, dans MODULES, et BATS_DEMANDE : vrai pour le nom wrapper.
choisir_scenarios() {
	local nom module deja
	MODULES=("${TOUJOURS[@]}")
	BATS_DEMANDE=false
	for nom in "$@"; do
		if [[ "${nom}" == wrapper ]]; then
			BATS_DEMANDE=true
			continue
		fi
		module="$(module_de "${nom}")" || erreur_usage "$(tf 'unknown feature: %s' "${nom}")"
		for deja in "${MODULES[@]}"; do
			[[ "${deja}" == "${module}" ]] && continue 2
		done
		MODULES+=("${module}")
	done
}

lancer_dev_test() {
	local venv scripts ligne liste
	MODULES=()
	BATS_DEMANDE=true
	if (($# > 0)); then
		[[ "$1" == --scenarios ]] || erreur_usage "$(tf 'unknown option of dev-test: %s' "$1")"
		shift
		(($# > 0)) || erreur_usage "$(t '--scenarios requires at least one feature')"
	fi
	venv="$(exiger_venv)"
	cd "$(projet)"
	(($# == 0)) || choisir_scenarios "$@"
	export VIRTUAL_ENV="${venv}"
	PATH="${venv}/bin:${PATH}"
	export PATH
	shopt -s nullglob
	scripts=(install.sh bin/Machin bin/i18n.bash bash-completion/Machin tests/wrapper/*.bash tests/wrapper/*.bats)
	shopt -u nullglob
	BILAN=()
	ECHOUES=()
	# Sans cache : ruff garderait le verdict d'un fichier inchangé, même quand un autre fichier change l'ordre de ses
	# imports (un module créé après coup passe de tiers à interne).
	verifier_avec "ruff check" venv ruff check --no-cache .
	verifier_avec "ruff format --check" venv ruff format --no-cache --check .
	verifier_avec "mypy --strict" venv mypy --strict src/
	verifier_avec "shellcheck" PATH shellcheck -x "${scripts[@]}"
	verifier_avec "pytest" venv pytest "${MODULES[@]}"
	if "${BATS_DEMANDE}"; then
		verifier_avec "bats" PATH bats tests/wrapper
	else
		BILAN+=("$(tf '%-22s not run' bats)")
	fi
	tf '\n==> Summary\n'
	for ligne in "${BILAN[@]}"; do
		printf '    %s\n' "${ligne}"
	done
	if ((${#ECHOUES[@]} == 0)); then
		tf '    all the tools passed\n'
		exit 0
	fi
	liste="$(printf '%s, ' "${ECHOUES[@]}")"
	if ((${#ECHOUES[@]} == 1)); then
		tf '    1 tool failed: %s\n' "${liste%, }"
	else
		tf '    %s tools failed: %s\n' "${#ECHOUES[@]}" "${liste%, }"
	fi
	exit 1
}

# Captures d'écran du guide de l'antenne (https://github.com/dascritch/machincast/issues/128) : tests/screenshots.py,
# avec le Python du venv, depuis le répertoire de MachinCast, où il trouve le paquet tests.
lancer_dev_captures() {
	local venv
	venv="$(exiger_venv)"
	cd "$(projet)"
	export VIRTUAL_ENV="${venv}"
	exec "${venv}/bin/python" -m tests.screenshots "$@"
}

# Achève les rapports de crash en cours du binaire $2, de chemin $1 (python -m machincast.crash), avec le Python du
# binaire : celui de son venv, sinon celui de sa ligne #!. Les options qui suivent sont celles de la configuration.
achever_rapports() {
	local chemin="$1" programme="$2" python="${1%/*}/python" premiere=""
	shift 2
	if [[ ! -x "${python}" ]]; then
		IFS= read -r premiere <"${chemin}" || true
		python="${premiere#\#!}"
		[[ "${premiere}" == '#!'* && -x "${python}" ]] || return 0
	fi
	"${python}" -m machincast.crash "${programme}" "$@" || true
}

principal() {
	local configuration=() binaire chemin

	while (($# > 0)); do
		case "$1" in
			-h)
				aide_minimale
				exit 0
				;;
			--help)
				aide_complete
				exit 0
				;;
			--binaries)
				printf '%s\n' "${BINAIRES[@]}"
				exit 0
				;;
			--config)
				if (($# < 2)) || [[ -z "$2" ]]; then
					erreur_usage "$(t '--config requires a file')"
				fi
				configuration=(--config "$2")
				shift 2
				;;
			--config=*)
				[[ -n "${1#--config=}" ]] || erreur_usage "$(t '--config requires a file')"
				configuration=(--config "${1#--config=}")
				shift
				;;
			-*)
				erreur_usage "$(tf 'unknown option: %s' "$1")"
				;;
			*)
				break
				;;
		esac
	done

	(($# > 0)) || erreur_usage "$(t 'missing binary')"
	binaire="$1"
	shift

	if [[ "${binaire}" == logs ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "$(tf '--config does not apply to %s' logs)"
		suivre_logs "$@"
	fi
	if [[ "${binaire}" == dev || "${binaire}" == dev-test ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "$(tf '--config does not apply to %s' "${binaire}")"
		if [[ "${binaire}" == dev ]]; then
			(($# == 0)) || erreur_usage "$(tf '%s takes no argument' dev)"
			ouvrir_dev
		fi
		lancer_dev_test "$@"
	fi

	if [[ "${binaire}" == dev-screenshots ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "$(tf '--config does not apply to %s' dev-screenshots)"
		(($# <= 1)) || erreur_usage "$(t 'dev-screenshots takes at most one directory')"
		lancer_dev_captures "$@"
	fi

	est_binaire "${binaire}" || erreur_usage "$(tf 'unknown binary: %s' "${binaire}")"

	if ! chemin="$(trouver_binaire "${binaire}")"; then
		tf 'Machin: Machin_%s not found in %s nor in the PATH.\n' "${binaire}" "$(venv_du_projet)" >&2
		tf '         Create the venv from the root of the project: python3 -m venv .venv && .venv/bin/pip install -e ".[dev]"\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi

	# Pas d'exec : un binaire mort d'un signal (code 128 + n, kill -9 compris) laisse un rapport de crash en cours, que
	# le wrapper fait achever aussitôt (https://github.com/dascritch/machincast/issues/413). Ctrl-C et SIGTERM vont au
	# binaire, par le groupe du terminal ou le cgroup du service ; le wrapper attend sa fin, puis rend son code.
	trap ':' INT TERM HUP
	local code=0
	"${chemin}" "${configuration[@]}" "$@" || code=$?
	trap - INT TERM HUP
	if ((code > 128 && code < 160)); then
		achever_rapports "${chemin}" "Machin_${binaire}" "${configuration[@]}"
	fi
	exit "${code}"
}

principal "$@"
