#!/usr/bin/env bash
# Machin : commande unique d'accès aux binaires de MachinCast (https://github.com/dascritch/machincast/issues/6).
#
#   Machin [--config FICHIER] BINAIRE [OPTIONS…]   appelle Machin_BINAIRE en lui transmettant les options
#   Machin logs [OPTIONS DE journalctl…]           suit en direct le journal du service de lecture
#   Machin dev                                      sous-shell de développement, venv activé
#   Machin dev-test                                 lance tous les outils de vérification, avec un bilan
#   Machin dev-captures [REPERTOIRE]                refait les captures d'écran du guide de l'antenne
#
# Règles : doc/regles/wrapper.md. Tests : bats tests/wrapper.

set -euo pipefail

# Binaires connus, dans l'ordre de l'aide. Un test vérifie qu'ils correspondent à [project.scripts] de pyproject.toml.
BINAIRES=(lecture indexation interface maintenance-db)
UNITE_LECTURE="machincast.service"

CODE_USAGE=2
CODE_INTROUVABLE=127

aide_minimale() {
	local liste
	liste="$(printf '%s, ' "${BINAIRES[@]}")"
	cat <<-FIN
		Usage : Machin [--config FICHIER] BINAIRE [OPTIONS…]  ou  Machin logs|dev|dev-test|dev-captures
		Binaires : ${liste%, }. Aide complète : Machin --help
	FIN
}

aide_complete() {
	cat <<-FIN
		Machin — commande unique d'accès aux binaires de MachinCast.

		Usage :
		  Machin [--config FICHIER] BINAIRE [OPTIONS…]
		  Machin logs [OPTIONS DE journalctl…]
		  Machin dev | dev-test | dev-captures [REPERTOIRE]
		  Machin -h | --help | --binaires

		Binaires (Machin BINAIRE appelle Machin_BINAIRE avec les options qui suivent,
		pris dans le venv .venv du projet, sans qu'il soit activé, ou à défaut dans le PATH) :
		  lecture      diffusion de l'antenne, normalement lancée comme service systemd
		  indexation   vérification des fichiers sonores et mise à jour de la base
		  interface    interface graphique de programmation
		  maintenance-db
		               sauvegarde, vérifie et optimise la base de données
		               (https://github.com/dascritch/machincast/issues/127)

		  Aide d'un binaire : Machin BINAIRE --help

		Suivi des logs :
		  logs         suit en direct le journal du service ${UNITE_LECTURE} (journalctl --follow).
		               Les options qui suivent sont transmises à journalctl, par exemple :
		               Machin logs --since "1 hour ago" --priority=warning
		               Lire ce journal demande d'appartenir au groupe adm ou systemd-journal :
		               install.sh y ajoute le compte qui l'installe.

		Développement (poste installé par ./install.sh --dev) :
		  dev          ouvre un sous-shell dans le répertoire de MachinCast, venv activé, avec
		               l'invite « (MachinCast dev) » ; exit en sort
		  dev-test     lance ruff check, ruff format --check, mypy --strict, shellcheck, pytest
		               puis bats, tous même après un échec, avec les outils du venv sans qu'il
		               soit activé ; affiche un bilan par outil et se termine en échec si l'un
		               d'eux échoue. Un outil absent se signale : ./install.sh --dev l'installe.
		  dev-captures refait les captures d'écran du guide de l'antenne, dans doc/captures
		               ou dans REPERTOIRE : l'interface hors de l'écran, sur une démonstration
		               écrite dans la base de test, jamais dans celle de production.

		Options du wrapper :
		  --config FICHIER, --config=FICHIER
		               fichier de configuration TOML transmis au binaire
		               (par défaut, le binaire lit machincast.toml dans le répertoire de MachinCast :
		               $(projet)/machincast.toml)
		  -h           aide minimale
		  --help       cette aide complète
		  --binaires   liste des binaires, un par ligne (utilisée par l'autocomplétion)

		Exemples :
		  Machin lecture --config essai.toml
		  Machin indexation --help
		  Machin logs
		  Machin dev-test

		Codes de sortie :
		  celui du binaire appelé, de journalctl pour logs, ou du sous-shell pour dev ;
		  1            dev-test : au moins un outil en échec ou absent ;
		  ${CODE_USAGE}            appel incorrect du wrapper (binaire ou option inconnus) ;
		  ${CODE_INTROUVABLE}          binaire, journalctl ou venv introuvable.

		Documentation : https://github.com/dascritch/machincast/blob/main/doc/spec.md#7-wrapper-machin
	FIN
}

erreur_usage() {
	printf 'Machin : %s\n' "$1" >&2
	aide_minimale >&2
	exit "${CODE_USAGE}"
}

# Répertoire de MachinCast : le parent du répertoire bin/ où se trouve le wrapper. Le lien symbolique éventuel
# (par exemple /usr/local/bin/Machin) est résolu pour trouver le vrai projet. Les binaires y lisent machincast.toml
# par défaut (https://github.com/dascritch/machincast/issues/76).
projet() {
	local wrapper
	wrapper="$(readlink -f "${BASH_SOURCE[0]}")"
	dirname "$(dirname "${wrapper}")"
}

# Venv du projet : .venv à la racine du projet.
venv_du_projet() {
	printf '%s/.venv\n' "$(projet)"
}

# Chemin de Machin_$1 : d'abord dans le venv du projet, sans qu'il soit activé, sinon dans le PATH.
trouver_binaire() {
	local nom="Machin_$1" venv
	venv="$(venv_du_projet)"
	if [[ -x "${venv}/bin/${nom}" ]]; then
		printf '%s\n' "${venv}/bin/${nom}"
	else
		command -v "${nom}"
	fi
}

est_binaire() {
	local binaire
	for binaire in "${BINAIRES[@]}"; do
		[[ "${binaire}" == "$1" ]] && return 0
	done
	return 1
}

suivre_logs() {
	if ! command -v journalctl >/dev/null; then
		printf 'Machin : journalctl introuvable : les logs du service sont lus dans le journal de systemd\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi
	exec journalctl --unit="${UNITE_LECTURE}" --follow "$@"
}

# Venv du projet, ou arrêt avec le code 127 et la façon de l'installer.
exiger_venv() {
	local venv
	venv="$(venv_du_projet)"
	if [[ ! -r "${venv}/bin/activate" ]]; then
		printf 'Machin : venv introuvable : %s\n' "${venv}" >&2
		printf '         Installer le poste de développement : ./install.sh --dev\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi
	printf '%s\n' "${venv}"
}

# Sous-shell de développement (https://github.com/dascritch/machincast/issues/77). Un programme ne peut pas activer
# le venv du shell qui l'a lancé : d'où un nouveau shell interactif, qui lit le .bashrc du compte, puis active le
# venv et signale son invite. Son fichier de démarrage s'efface dès qu'il est lu.
ouvrir_dev() {
	local venv demarrage
	venv="$(exiger_venv)"
	demarrage="$(mktemp "${TMPDIR:-/tmp}/machincast-dev.XXXXXX")"
	{
		# fichier de MachinCast : le fichier de démarrage du sous-shell, effacé dès qu'il est lu
		printf 'rm -f -- %q\n' "${demarrage}"
		# shellcheck disable=SC2016
		printf '%s\n' '[[ -r ~/.bashrc ]] && . ~/.bashrc'
		printf '. %q\n' "${venv}/bin/activate"
		printf 'export MACHINCAST_DEV=1\n'
		# shellcheck disable=SC2016
		printf '%s\n' 'PS1="(MachinCast dev) ${PS1-\$ }"'
	} >"${demarrage}"
	cd "$(projet)"
	exec bash --rcfile "${demarrage}" -i
}

# Lance un outil de vérification et note son résultat dans BILAN et ECHOUES. $1 : libellé ; $2 : venv ou PATH,
# où chercher l'outil ; $3 : outil ; la suite : ses arguments.
verifier_avec() {
	local libelle="$1" ou="$2" outil="$3" chemin="" code
	shift 3
	printf '\n==> %s\n' "${libelle}"
	if [[ "${ou}" == venv ]]; then
		[[ -x "${VIRTUAL_ENV}/bin/${outil}" ]] && chemin="${VIRTUAL_ENV}/bin/${outil}"
	else
		chemin="$(command -v "${outil}" || true)"
	fi
	if [[ -z "${chemin}" ]]; then
		printf 'Machin : %s introuvable : installer les outils de développement avec ./install.sh --dev\n' "${outil}" >&2
		BILAN+=("$(printf '%-22s absent' "${libelle}")")
		ECHOUES+=("${libelle}")
		return
	fi
	if "${chemin}" "$@"; then
		BILAN+=("$(printf '%-22s réussi' "${libelle}")")
	else
		code=$?
		BILAN+=("$(printf '%-22s échec (code %s)' "${libelle}" "${code}")")
		ECHOUES+=("${libelle}")
	fi
}

# Vérifications du poste de développement (https://github.com/dascritch/machincast/issues/77) : les commandes de la
# section « Qualité » et « Tests » de CLAUDE.md, toutes lancées même après un échec.
lancer_dev_test() {
	local venv scripts ligne liste
	venv="$(exiger_venv)"
	cd "$(projet)"
	export VIRTUAL_ENV="${venv}"
	PATH="${venv}/bin:${PATH}"
	export PATH
	shopt -s nullglob
	scripts=(install.sh bin/Machin bash-completion/Machin tests/wrapper/*.bash tests/wrapper/*.bats)
	shopt -u nullglob
	BILAN=()
	ECHOUES=()
	# Sans cache : ruff garderait le verdict d'un fichier inchangé, même quand un autre fichier change l'ordre de ses
	# imports (un module créé après coup passe de tiers à interne).
	verifier_avec "ruff check" venv ruff check --no-cache .
	verifier_avec "ruff format --check" venv ruff format --no-cache --check .
	verifier_avec "mypy --strict" venv mypy --strict src/
	verifier_avec "shellcheck" PATH shellcheck -x "${scripts[@]}"
	verifier_avec "pytest" venv pytest
	verifier_avec "bats" PATH bats tests/wrapper
	printf '\n==> Bilan\n'
	for ligne in "${BILAN[@]}"; do
		printf '    %s\n' "${ligne}"
	done
	if ((${#ECHOUES[@]} == 0)); then
		printf '    tous les outils ont réussi\n'
		exit 0
	fi
	liste="$(printf '%s, ' "${ECHOUES[@]}")"
	if ((${#ECHOUES[@]} == 1)); then
		printf '    1 outil en échec : %s\n' "${liste%, }"
	else
		printf '    %s outils en échec : %s\n' "${#ECHOUES[@]}" "${liste%, }"
	fi
	exit 1
}

# Captures d'écran du guide de l'antenne (https://github.com/dascritch/machincast/issues/128) : tests/captures.py,
# avec le Python du venv, depuis le répertoire de MachinCast, où il trouve le paquet tests.
lancer_dev_captures() {
	local venv
	venv="$(exiger_venv)"
	cd "$(projet)"
	export VIRTUAL_ENV="${venv}"
	exec "${venv}/bin/python" -m tests.captures "$@"
}

principal() {
	local configuration=() binaire chemin

	while (($# > 0)); do
		case "$1" in
			-h)
				aide_minimale
				exit 0
				;;
			--help)
				aide_complete
				exit 0
				;;
			--binaires)
				printf '%s\n' "${BINAIRES[@]}"
				exit 0
				;;
			--config)
				if (($# < 2)) || [[ -z "$2" ]]; then
					erreur_usage "--config demande un fichier"
				fi
				configuration=(--config "$2")
				shift 2
				;;
			--config=*)
				[[ -n "${1#--config=}" ]] || erreur_usage "--config demande un fichier"
				configuration=(--config "${1#--config=}")
				shift
				;;
			-*)
				erreur_usage "option inconnue : $1"
				;;
			*)
				break
				;;
		esac
	done

	(($# > 0)) || erreur_usage "binaire manquant"
	binaire="$1"
	shift

	if [[ "${binaire}" == logs ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "--config ne s'applique pas à logs"
		suivre_logs "$@"
	fi
	if [[ "${binaire}" == dev || "${binaire}" == dev-test ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "--config ne s'applique pas à ${binaire}"
		(($# == 0)) || erreur_usage "${binaire} ne prend pas d'argument"
		[[ "${binaire}" == dev ]] && ouvrir_dev
		lancer_dev_test
	fi

	if [[ "${binaire}" == dev-captures ]]; then
		((${#configuration[@]} == 0)) || erreur_usage "--config ne s'applique pas à dev-captures"
		(($# <= 1)) || erreur_usage "dev-captures prend au plus un répertoire"
		lancer_dev_captures "$@"
	fi

	est_binaire "${binaire}" || erreur_usage "binaire inconnu : ${binaire}"

	if ! chemin="$(trouver_binaire "${binaire}")"; then
		printf 'Machin : Machin_%s introuvable dans %s ni dans le PATH.\n' "${binaire}" "$(venv_du_projet)" >&2
		printf '         Créer le venv depuis la racine du projet : python3 -m venv .venv && .venv/bin/pip install -e ".[dev]"\n' >&2
		exit "${CODE_INTROUVABLE}"
	fi

	exec "${chemin}" "${configuration[@]}" "$@"
}

principal "$@"
