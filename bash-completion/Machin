# shellcheck shell=bash
# Autocomplétion bash du wrapper Machin (https://github.com/dascritch/machincast/issues/6).
#
# Installée dans /usr/share/bash-completion/completions/Machin, ou chargée à la main :
#   source bash-completion/Machin
#
# Les binaires viennent de « Machin --binaires », les options d'un binaire de son aide (« Machin BINAIRE --help ») :
# la complétion suit le code sans liste à tenir à jour.

# Options courantes de journalctl, proposées après « Machin logs ».
_MACHIN_OPTIONS_LOGS="--since --until --lines --priority --grep --output --no-hostname --boot"

_Machin() {
	local commande="${COMP_WORDS[0]}" courant="${COMP_WORDS[COMP_CWORD]}" precedent="${COMP_WORDS[COMP_CWORD - 1]}"
	local i binaire=""
	COMPREPLY=()

	# Valeur de --config, sous la forme « --config FICHIER » ou « --config=FICHIER » (que bash coupe autour du « = »).
	if [[ "${precedent}" == --config ]] \
		|| { [[ "${precedent}" == = ]] && ((COMP_CWORD >= 2)) && [[ "${COMP_WORDS[COMP_CWORD - 2]}" == --config ]]; }; then
		compopt -o filenames 2>/dev/null
		mapfile -t COMPREPLY < <(compgen -f -- "${courant}")
		return 0
	fi
	if [[ "${courant}" == = ]] && [[ "${precedent}" == --config ]]; then
		return 0
	fi

	# Premier mot qui n'est ni une option du wrapper ni la valeur de --config : le binaire.
	for ((i = 1; i < COMP_CWORD; i++)); do
		case "${COMP_WORDS[i]}" in
			--config)
				[[ "${COMP_WORDS[i + 1]-}" == = ]] && ((i++))
				((i++))
				;;
			-*) ;;
			*)
				binaire="${COMP_WORDS[i]}"
				break
				;;
		esac
	done

	if [[ -z "${binaire}" ]]; then
		if [[ "${courant}" == -* ]]; then
			mapfile -t COMPREPLY < <(compgen -W "-h --help --config --binaires" -- "${courant}")
		else
			mapfile -t COMPREPLY < <(compgen -W "$("${commande}" --binaires 2>/dev/null) logs dev dev-test dev-captures" \
				-- "${courant}")
		fi
		return 0
	fi

	# dev et dev-test ne prennent aucun argument ; dev-captures, un répertoire.
	if [[ "${binaire}" == dev || "${binaire}" == dev-test ]]; then
		return 0
	fi
	if [[ "${binaire}" == dev-captures ]]; then
		compopt -o filenames 2>/dev/null
		mapfile -t COMPREPLY < <(compgen -d -- "${courant}")
		return 0
	fi
	if [[ "${binaire}" == logs ]]; then
		mapfile -t COMPREPLY < <(compgen -W "${_MACHIN_OPTIONS_LOGS}" -- "${courant}")
		return 0
	fi

	if [[ "${courant}" == -* ]]; then
		# Options affichées par l'aide argparse du binaire : « -h, --help », « --config FICHIER »…
		local options
		options="$("${commande}" "${binaire}" --help 2>/dev/null \
			| grep -oE '(^|[[:space:],])--?[[:alnum:]][-[:alnum:]]*' | tr -d ' ,' | sort -u)"
		mapfile -t COMPREPLY < <(compgen -W "${options}" -- "${courant}")
	fi
	return 0
}

complete -F _Machin Machin
