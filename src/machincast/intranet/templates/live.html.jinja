{#- L'antenne en direct (https://github.com/dascritch/machincast/issues/541) : l'heure, le texte public, l'événement en cours et le suivant, le sonore en cours et le prochain, côte à côte, puis les derniers sonores diffusés. Le script de l'intranet relit les éléments par leur id, et tient les décomptes d'après data-limite. -#}
{% macro field(label, identifier, text) %}<dt>{{ label }}</dt><dd><span id="{{ identifier }}">{{ text }}</span></dd>{% endmacro %}
{% macro countdown(label, identifier, value) %}<dt>{{ label }}</dt><dd><span id="{{ identifier }}" class="decompte" data-limite="{{ value.limit }}">{{ value.text }}</span></dd>{% endmacro %}
<div id="direct">
<p class="heure"><span id="heure">{{ live.hour }}</span></p>
<p class="texte-public"><span id="texte-public">{{ live.public_text }}</span></p>
<div class="paire">
<section class="evenement">
<h2>{{ _("Current event") }}</h2>
<dl>{{ field(_("Name"), "evenement-nom", live.event.name) }}{{ field(_("Start"), "evenement-debut", live.event.start) }}{{ field(_("End"), "evenement-fin", live.event.end) }}{{ countdown(_("Remaining"), "evenement-reste", live.event.remaining) }}</dl>
</section>
<section class="suivant">
<h2>{{ _("Next event") }}</h2>
<dl>{{ field(_("Name"), "suivant-nom", live.next_event.name) }}{{ field(_("Start"), "suivant-debut", live.next_event.start) }}{{ field(_("End"), "suivant-fin", live.next_event.end) }}</dl>
</section>
</div>
<div class="paire">
<section class="sonore">
<h2>{{ _("Current sound") }}</h2>
<dl>{{ field(_("Sound"), "sonore-nom", live.sound.name) }}{{ field(_("Duration"), "sonore-duree", live.sound.duration) }}{{ countdown(_("Remaining"), "sonore-reste", live.sound.remaining) }}</dl>
</section>
<section class="prochain">
<h2>{{ _("Next sound") }}</h2>
<dl>{{ field(_("Sound"), "prochain-nom", live.next_sound.name) }}{{ field(_("Duration"), "prochain-duree", live.next_sound.duration) }}{{ countdown(_("Starts in"), "prochain-attente", live.next_sound.starts_in) }}</dl>
</section>
</div>
<section class="airplay">
<h2>{{ _("Last sounds on air") }}</h2>
<ol id="airplay">{% for play in live.airplay %}<li>{{ play.hour }} {{ play.name }}</li>{% endfor %}</ol>
</section>
</div>
