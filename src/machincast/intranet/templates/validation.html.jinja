{#- La page qui demande le code donné au pupitre, et ce qui a refusé le précédent (https://github.com/dascritch/machincast/issues/539) ;
    sans code, elle se relit jusqu'à ce que le pupitre accepte la connexion (https://github.com/dascritch/machincast/issues/600). -#}
{% extends "page.html.jinja" %}
{% block head %}
{% if not with_code %}
<meta http-equiv="refresh" content="5">
{% endif %}
{{ head }}
{% endblock %}
{% block body %}
<h1>{{ title }}</h1>
<p>{{ explanation }}</p>
{% if with_code %}
<form method="post" action="/validation">
<p><label>{{ _("6-digit code") }}<br><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus></label></p>
<p><button type="submit">{{ _("Validate") }}</button></p>
</form>
{% endif %}
{% if message %}
<p role="alert">{{ message }}</p>
{% endif %}
<form method="post" action="/logout"><p><button type="submit">{{ _("Disconnect") }}</button></p></form>
{% endblock %}
