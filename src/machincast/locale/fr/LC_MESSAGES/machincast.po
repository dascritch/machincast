#: machincast/indexer/__main__.py:29
msgid "Checks the sounds and indexes the bank directories."
msgstr "Vérifie les sonores et indexe les répertoires des banques."

#: machincast/indexer/__main__.py:41
msgid ""
"decodes all sounds; by default, the quick indexing only decodes the sounds "
"in preview"
msgstr ""
"décode tous les sonores ; par défaut, l'indexation rapide ne décode que les "
"sonores en aperçu"

#: machincast/indexer/__main__.py:46
msgid ""
"with --full-audit, also decodes the sounds already audited at the same "
"silence threshold, whose file has not changed since; without it, the full "
"audit skips them"
msgstr ""
"avec --full-audit, décode aussi les sonores déjà audités au même seuil de "
"silence, dont le fichier n'a pas changé depuis ; sans lui, l'audit complet "
"les saute"

#: machincast/indexer/__main__.py:54
msgid ""
"shows the indexing log in a window, line by line, as the interface launches "
"it"
msgstr ""
"montre le journal de l'indexation dans une fenêtre, ligne par ligne, comme "
"le lance l'interface"

#: machincast/indexer/__main__.py:60
msgid ""
"only checks sound N, without scanning the directories nor writing an audit "
"document; with --full-audit, its file is decoded unless it was already "
"audited, unchanged, at the same threshold"
msgstr ""
"ne vérifie que le sonore N, sans parcourir les répertoires ni écrire de "
"document d'audit ; avec --full-audit, son fichier est décodé s'il n'a pas "
"déjà été audité, inchangé, au même seuil"

#: machincast/indexer/__main__.py:71
msgid "--sound is not used with --window"
msgstr "--sound ne s'emploie pas avec --window"

#: machincast/indexer/__main__.py:74
msgid "--force is only used with --full-audit"
msgstr "--force ne s'emploie qu'avec --full-audit"

#: machincast/indexer/__main__.py:80
msgid ""
"--window needs a graphical display: without one, run Machin indexer without "
"--window"
msgstr ""
"--window demande un affichage graphique : sans lui, lancer Machin indexer "
"sans --window"

