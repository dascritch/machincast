<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PreferencesWindow</class>
 <widget class="QDialog" name="PreferencesWindow">
  <property name="windowTitle">
   <string>Preferences</string>
  </property>
  <layout class="QVBoxLayout" name="arrangement">
   <item>
    <widget class="QTabWidget" name="pages">
     <widget class="QWidget" name="page_crossfades">
      <attribute name="title">
       <string>Crossfades</string>
      </attribute>
      <layout class="QVBoxLayout" name="crossfades_layout">
       <item>
        <widget class="QGroupBox" name="crossfades_group">
         <property name="title">
          <string>Durations</string>
         </property>
         <layout class="QFormLayout" name="crossfades_form">
          <item row="0" column="0">
           <widget class="QLabel" name="granularity_caption">
            <property name="text">
             <string>&amp;Granularity</string>
            </property>
            <property name="buddy">
             <cstring>granularity</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="granularity">
            <property name="toolTip">
             <string>The step of all the crossfades of the interface</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="maximum_caption">
            <property name="text">
             <string>&amp;Maximum duration</string>
            </property>
            <property name="buddy">
             <cstring>maximum</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="maximum">
            <property name="toolTip">
             <string>The longest crossfade that the cards offer</string>
            </property>
            <property name="suffix">
             <string notr="true"> s</string>
            </property>
            <property name="maximum">
             <double>600.0</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QCheckBox" name="has_start">
            <property name="text">
             <string>Default &amp;start</string>
            </property>
            <property name="toolTip">
             <string>The start crossfade of a sound that has none set, and that its bank does not set</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="start">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string notr="true"> s</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="has_end">
            <property name="text">
             <string>Default &amp;end</string>
            </property>
            <property name="toolTip">
             <string>The end crossfade of a sound that has none set, and that its bank does not set</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="end">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string notr="true"> s</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="position_group">
         <property name="title">
          <string>Position of the fades, for a sound played without its silences</string>
         </property>
         <property name="toolTip">
          <string>Where the fades fall compared to the detected start and end of a sound played without its silences, whatever its bank</string>
         </property>
         <layout class="QFormLayout" name="position_form">
          <item row="0" column="0">
           <widget class="QLabel" name="entry_position_caption">
            <property name="text">
             <string>The fade-in, at the detected start</string>
            </property>
            <property name="buddy">
             <cstring>entry_position</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="entry_position"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="output_position_caption">
            <property name="text">
             <string>The fade-out, at the detected end</string>
            </property>
            <property name="buddy">
             <cstring>output_position</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="output_position"/>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QWidget" name="place_demonstration" native="true">
            <property name="toolTip">
             <string>Demonstration: a sound of 30 s, with silences of 3 s at the start and 4 s at the end, removed on air, with the default crossfades entered</string>
            </property>
            <property name="minimumSize">
             <size>
              <width>360</width>
              <height>72</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QLabel" name="demonstration_legend">
            <property name="text">
             <string/>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="silence_group">
         <property name="title">
          <string>Silence detection</string>
         </property>
         <layout class="QFormLayout" name="silence_form">
          <item row="0" column="0">
           <widget class="QLabel" name="silence_threshold_caption">
            <property name="text">
             <string>&amp;Silence threshold</string>
            </property>
            <property name="buddy">
             <cstring>silence_threshold</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="silence_threshold">
            <property name="toolTip">
             <string>Peak level below which the start and the end of a sound are a silence; 0 dB is the full scale</string>
            </property>
            <property name="suffix">
             <string notr="true"> dB</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>-100.0</double>
            </property>
            <property name="maximum">
             <double>-0.1</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>-40.0</double>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="silence_explanation">
         <property name="text">
          <string>The full audit measures the silences at the start and at the end of each file at this threshold; a new threshold applies to the next audits. A bank, or a sound, chooses to be played without its silences.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="explanation">
         <property name="text">
          <string>The cards opened afterwards follow these settings. Machin player takes the default durations at its next start.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_interface">
      <attribute name="title">
       <string>Interface</string>
      </attribute>
      <layout class="QVBoxLayout" name="interface_layout">
       <item>
        <widget class="QGroupBox" name="home_group">
         <property name="title">
          <string>Home</string>
         </property>
         <layout class="QVBoxLayout" name="home_layout">
          <item>
           <widget class="QCheckBox" name="clipping">
            <property name="text">
             <string>Show the clipping light of the On air tab</string>
            </property>
            <property name="toolTip">
             <string>The “Clipping” light of the On air column, above the VU meter; the VU meter always shows the peaks.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="suggestions">
            <property name="text">
             <string>Offer at launch what is missing to start</string>
            </property>
            <property name="toolTip">
             <string>Background programming, basic banks and on-air device, in a window when the interface is launched.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="tables_group">
         <property name="title">
          <string>Tables of the cards</string>
         </property>
         <layout class="QVBoxLayout" name="tables_layout">
          <item>
           <layout class="QFormLayout" name="tables_form">
            <item row="0" column="0">
             <widget class="QLabel" name="table_rows_caption">
              <property name="text">
               <string>&amp;Rows loaded at a time</string>
              </property>
              <property name="buddy">
               <cstring>table_rows</cstring>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="table_rows">
              <property name="minimum">
               <number>100</number>
              </property>
              <property name="maximum">
               <number>1000000</number>
              </property>
              <property name="singleStep">
               <number>100</number>
              </property>
              <property name="value">
               <number>1000</number>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="table_rows_explanation">
            <property name="text">
             <string>The sounds of a bank, and the items of a sequence or an event, are loaded this many at a time in their card: the rest comes as you scroll down. A higher number can strongly slow down the interface for a bank with a very large number of sounds.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="icon_group">
         <property name="title">
          <string>Application icon</string>
         </property>
         <property name="toolTip">
          <string>The icon of the MachinCast windows, of its shortcut in the applications menu and on the desktop, and of the taskbar.</string>
         </property>
         <layout class="QVBoxLayout" name="icon_layout">
          <item>
           <layout class="QHBoxLayout" name="icon_line" stretch="0,1,0,0">
            <item>
             <widget class="QLabel" name="preview_icon">
              <property name="minimumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
              <property name="maximumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="path_icon">
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="textInteractionFlags">
               <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="choose_icon">
              <property name="text">
               <string>&amp;Choose an image…</string>
              </property>
              <property name="toolTip">
               <string>An SVG, PNG or JPEG image, preferably square</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="default_icon">
              <property name="text">
               <string>MachinCast icon</string>
              </property>
              <property name="toolTip">
               <string>Go back to the MachinCast icon</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="error_icon">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_audio">
      <attribute name="title">
       <string>Audio</string>
      </attribute>
      <layout class="QVBoxLayout" name="audio_layout">
       <item>
        <widget class="QGroupBox" name="device_group">
         <property name="title">
          <string>Sound cards</string>
         </property>
         <layout class="QVBoxLayout" name="device_layout"/>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="audio_explanation">
         <property name="text">
          <string>Machin player takes the output type and the on-air card at its next start; without an on-air card, it refuses to broadcast. The pre-listen can never use the on-air card: each one is greyed out in the other choice. “Test” plays 2 seconds of test sound on the card of its line.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="dead_air_group">
         <property name="title">
          <string>Dead air in a sound, on air</string>
         </property>
         <layout class="QFormLayout" name="dead_air_form">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="dead_air_fallback">
            <property name="toolTip">
             <string>Ticked, a dead air moves on to the next sound, or to the fallback of a stream; otherwise, it is only noted in the log</string>
            </property>
            <property name="text">
             <string>Move on to the next sound, or to the fallback of a s&amp;tream</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="dead_air_duration_caption">
            <property name="text">
             <string>D&amp;uration of a dead air</string>
            </property>
            <property name="buddy">
             <cstring>dead_air_duration</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="dead_air_duration">
            <property name="toolTip">
             <string>Duration for which a playing sound must stay below the dead air level</string>
            </property>
            <property name="suffix">
             <string notr="true"> s</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>1.0</double>
            </property>
            <property name="maximum">
             <double>300.0</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>10.0</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="dead_air_threshold_caption">
            <property name="text">
             <string>Dead air &amp;level</string>
            </property>
            <property name="buddy">
             <cstring>dead_air_threshold</cstring>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="dead_air_threshold">
            <property name="toolTip">
             <string>Peak level below which a playing sound no longer gives any sound; 0 dB is the full scale</string>
            </property>
            <property name="suffix">
             <string notr="true"> dB</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>-100.0</double>
            </property>
            <property name="maximum">
             <double>-0.1</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>-90.0</double>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="dead_air_explanation">
         <property name="text">
          <string>A sound that stays this duration below this level, while it plays, is noted in the log. Ticked, a file at once leaves the on-air output to the next sound, and a stream to its fallback, until its sound comes back. It is not a silence, at the start or at the end of a file. Machin player takes these settings at its next start.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="audio_space">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="database_page">
      <attribute name="title">
       <string>Database</string>
      </attribute>
      <layout class="QVBoxLayout" name="database_layout">
       <item>
        <layout class="QFormLayout" name="database_form">
         <item row="0" column="0">
          <widget class="QLabel" name="retention_caption">
           <property name="text">
            <string>Expiry &amp;duration</string>
           </property>
           <property name="buddy">
            <cstring>retention</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="retention">
           <property name="suffix">
            <string> days</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>3650</number>
           </property>
           <property name="value">
            <number>60</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="retention_explanation">
         <property name="text">
          <string>Machin purge erases from the database the plays of the airplay and the lines of the log older than this duration, and the sounds, banks, sequences and events deleted for longer. It never touches the sound files.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="database_space">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttons">
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
