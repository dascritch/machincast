<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PreferencesWindow</class>
 <widget class="QDialog" name="PreferencesWindow">
  <property name="windowTitle">
   <string>Préférences</string>
  </property>
  <layout class="QVBoxLayout" name="arrangement">
   <item>
    <widget class="QTabWidget" name="pages">
     <widget class="QWidget" name="page_crossfades">
      <attribute name="title">
       <string>Crossfades</string>
      </attribute>
      <layout class="QVBoxLayout" name="crossfades_layout">
       <item>
        <widget class="QGroupBox" name="crossfades_group">
         <property name="title">
          <string>Durées</string>
         </property>
         <layout class="QFormLayout" name="crossfades_form">
          <item row="0" column="0">
           <widget class="QLabel" name="granularity_caption">
            <property name="text">
             <string>&amp;Granularité</string>
            </property>
            <property name="buddy">
             <cstring>granularity</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="granularity">
            <property name="toolTip">
             <string>Le pas de tous les crossfades de l'interface</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="maximum_caption">
            <property name="text">
             <string>Durée &amp;maximale</string>
            </property>
            <property name="buddy">
             <cstring>maximum</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="maximum">
            <property name="toolTip">
             <string>Le crossfade le plus long que proposent les fiches</string>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
            <property name="maximum">
             <double>600.0</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QCheckBox" name="has_start">
            <property name="text">
             <string>&amp;Début par défaut</string>
            </property>
            <property name="toolTip">
             <string>Le crossfade de début d'un sonore qui n'en a pas de paramétré, et que sa banque ne règle pas</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="start">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="has_end">
            <property name="text">
             <string>&amp;Fin par défaut</string>
            </property>
            <property name="toolTip">
             <string>Le crossfade de fin d'un sonore qui n'en a pas de paramétré, et que sa banque ne règle pas</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="end">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="position_group">
         <property name="title">
          <string>Position des fondus, pour un sonore joué sans ses silences</string>
         </property>
         <property name="toolTip">
          <string>Où tombent les fondus par rapport au début et à la fin détectés d'un sonore joué sans ses silences, quelle que soit sa banque</string>
         </property>
         <layout class="QFormLayout" name="position_form">
          <item row="0" column="0">
           <widget class="QLabel" name="entry_position_caption">
            <property name="text">
             <string>Le fade-in, au début détecté</string>
            </property>
            <property name="buddy">
             <cstring>entry_position</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="entry_position"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="output_position_caption">
            <property name="text">
             <string>Le fade-out, à la fin détectée</string>
            </property>
            <property name="buddy">
             <cstring>output_position</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="output_position"/>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QWidget" name="place_demonstration" native="true">
            <property name="toolTip">
             <string>Démonstration : un sonore de 30 s, aux silences de 3 s au début et 4 s à la fin, retirés à l'antenne, avec les crossfades par défaut saisis</string>
            </property>
            <property name="minimumSize">
             <size>
              <width>360</width>
              <height>72</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QLabel" name="demonstration_legend">
            <property name="text">
             <string/>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="silence_group">
         <property name="title">
          <string>Détection de silence</string>
         </property>
         <layout class="QFormLayout" name="silence_form">
          <item row="0" column="0">
           <widget class="QLabel" name="silence_threshold_caption">
            <property name="text">
             <string>&amp;Seuil de silence</string>
            </property>
            <property name="buddy">
             <cstring>silence_threshold</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="silence_threshold">
            <property name="toolTip">
             <string>Niveau crête sous lequel le début et la fin d'un sonore sont un silence ; 0 dB est la pleine échelle</string>
            </property>
            <property name="suffix">
             <string> dB</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>-100.0</double>
            </property>
            <property name="maximum">
             <double>-0.1</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>-40.0</double>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="silence_explanation">
         <property name="text">
          <string>L'audit complet mesure les silences au début et à la fin de chaque fichier à ce seuil ; un nouveau seuil vaut pour les audits suivants. Une banque, ou un sonore, choisit d'être joué sans ses silences.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="explanation">
         <property name="text">
          <string>Les fiches ouvertes ensuite suivent ces réglages. Machin player prend les durées par défaut à son prochain démarrage.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_interface">
      <attribute name="title">
       <string>Interface</string>
      </attribute>
      <layout class="QVBoxLayout" name="interface_layout">
       <item>
        <widget class="QGroupBox" name="home_group">
         <property name="title">
          <string>Accueil</string>
         </property>
         <layout class="QVBoxLayout" name="home_layout">
          <item>
           <widget class="QCheckBox" name="clipping">
            <property name="text">
             <string>Afficher le voyant de saturation de l'onglet Antenne</string>
            </property>
            <property name="toolTip">
             <string>Le voyant « Saturation » de la colonne Antenne, au-dessus du VU-mètre ; le VU-mètre montre toujours les crêtes.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="suggestions">
            <property name="text">
             <string>Proposer au lancement ce qui manque pour démarrer</string>
            </property>
            <property name="toolTip">
             <string>Fil musical, banques de base et périphérique de l'antenne, dans une fenêtre au lancement de l'interface.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="icon_group">
         <property name="title">
          <string>Icône de l'application</string>
         </property>
         <property name="toolTip">
          <string>L'icône des fenêtres de MachinCast, de son raccourci dans le menu des applications et sur le bureau, et de la barre des tâches.</string>
         </property>
         <layout class="QVBoxLayout" name="icon_layout">
          <item>
           <layout class="QHBoxLayout" name="icon_line" stretch="0,1,0,0">
            <item>
             <widget class="QLabel" name="preview_icon">
              <property name="minimumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
              <property name="maximumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="path_icon">
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="textInteractionFlags">
               <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="choose_icon">
              <property name="text">
               <string>&amp;Choisir une image…</string>
              </property>
              <property name="toolTip">
               <string>Une image SVG, PNG ou JPEG, de préférence carrée</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="default_icon">
              <property name="text">
               <string>Icône de MachinCast</string>
              </property>
              <property name="toolTip">
               <string>Revenir à l'icône de MachinCast</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="error_icon">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_audio">
      <attribute name="title">
       <string>Audio</string>
      </attribute>
      <layout class="QVBoxLayout" name="audio_layout">
       <item>
        <widget class="QGroupBox" name="device_group">
         <property name="title">
          <string>Cartes son</string>
         </property>
         <layout class="QVBoxLayout" name="device_layout"/>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="audio_explanation">
         <property name="text">
          <string>Machin player prend le type de sortie et la carte de l'antenne à son prochain démarrage ; sans carte d'antenne, il refuse de diffuser. La pré-écoute ne peut jamais utiliser la carte de l'antenne : chacune est grisée dans l'autre choix. « Tester » joue 2 secondes de son de test sur la carte de sa ligne.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="dead_air_group">
         <property name="title">
          <string>Blanc dans un sonore, à l'antenne</string>
         </property>
         <layout class="QFormLayout" name="dead_air_form">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="dead_air_fallback">
            <property name="toolTip">
             <string>Coché, un blanc fait passer au sonore suivant, ou au secours d'un stream ; sinon, il est seulement noté dans le log</string>
            </property>
            <property name="text">
             <string>Passer au sonore suivant, ou au secours d'un s&amp;tream</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="dead_air_duration_caption">
            <property name="text">
             <string>D&amp;urée d'un blanc</string>
            </property>
            <property name="buddy">
             <cstring>dead_air_duration</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="dead_air_duration">
            <property name="toolTip">
             <string>Durée pendant laquelle un sonore qui joue doit rester sous le niveau d'un blanc</string>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>1.0</double>
            </property>
            <property name="maximum">
             <double>300.0</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>10.0</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="dead_air_threshold_caption">
            <property name="text">
             <string>&amp;Niveau d'un blanc</string>
            </property>
            <property name="buddy">
             <cstring>dead_air_threshold</cstring>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="dead_air_threshold">
            <property name="toolTip">
             <string>Niveau crête sous lequel un sonore qui joue ne donne plus de son ; 0 dB est la pleine échelle</string>
            </property>
            <property name="suffix">
             <string> dB</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>-100.0</double>
            </property>
            <property name="maximum">
             <double>-0.1</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>-90.0</double>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="dead_air_explanation">
         <property name="text">
          <string>Un sonore qui reste cette durée sous ce niveau, pendant qu'il joue, est noté dans le log. Coché, un fichier laisse aussitôt l'antenne au sonore suivant, et un stream à son secours, jusqu'au retour de son son. Ce n'est pas un silence, au début ou à la fin d'un fichier. Machin player prend ces réglages à son prochain démarrage.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="audio_space">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="database_page">
      <attribute name="title">
       <string>Base</string>
      </attribute>
      <layout class="QVBoxLayout" name="database_layout">
       <item>
        <layout class="QFormLayout" name="database_form">
         <item row="0" column="0">
          <widget class="QLabel" name="retention_caption">
           <property name="text">
            <string>&amp;Durée de péremption</string>
           </property>
           <property name="buddy">
            <cstring>retention</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="retention">
           <property name="suffix">
            <string> jours</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>3650</number>
           </property>
           <property name="value">
            <number>60</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="retention_explanation">
         <property name="text">
          <string>Machin purge efface de la base les passages de l'airplay et les lignes du log plus vieux que cette durée, et les sonores, banques, séquences et événements supprimés depuis plus longtemps. Il ne touche jamais aux fichiers sonores.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="database_space">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttons">
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
