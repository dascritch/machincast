<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FenetrePreferences</class>
 <widget class="QDialog" name="FenetrePreferences">
  <property name="windowTitle">
   <string>Préférences</string>
  </property>
  <layout class="QVBoxLayout" name="disposition">
   <item>
    <widget class="QTabWidget" name="pages">
     <widget class="QWidget" name="page_crossfades">
      <attribute name="title">
       <string>Crossfades</string>
      </attribute>
      <layout class="QVBoxLayout" name="disposition_crossfades">
       <item>
        <widget class="QGroupBox" name="groupe_crossfades">
         <property name="title">
          <string>Durées</string>
         </property>
         <layout class="QFormLayout" name="formulaire_crossfades">
          <item row="0" column="0">
           <widget class="QLabel" name="etiquette_granularite">
            <property name="text">
             <string>&amp;Granularité</string>
            </property>
            <property name="buddy">
             <cstring>granularite</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="granularite">
            <property name="toolTip">
             <string>Le pas de tous les crossfades de l'interface</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="etiquette_maximum">
            <property name="text">
             <string>Durée &amp;maximale</string>
            </property>
            <property name="buddy">
             <cstring>maximum</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="maximum">
            <property name="toolTip">
             <string>Le crossfade le plus long que proposent les fiches</string>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
            <property name="maximum">
             <double>600.0</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QCheckBox" name="a_debut">
            <property name="text">
             <string>&amp;Début par défaut</string>
            </property>
            <property name="toolTip">
             <string>Le crossfade de début d'un sonore qui n'en a pas de paramétré, et que sa banque ne règle pas</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="debut">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="a_fin">
            <property name="text">
             <string>&amp;Fin par défaut</string>
            </property>
            <property name="toolTip">
             <string>Le crossfade de fin d'un sonore qui n'en a pas de paramétré, et que sa banque ne règle pas</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="fin">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupe_positions">
         <property name="title">
          <string>Position des fondus, pour un sonore joué sans ses blancs</string>
         </property>
         <property name="toolTip">
          <string>Où tombent les fondus par rapport au début et à la fin détectés d'un sonore joué sans ses blancs, quelle que soit sa banque</string>
         </property>
         <layout class="QFormLayout" name="formulaire_positions">
          <item row="0" column="0">
           <widget class="QLabel" name="etiquette_position_entree">
            <property name="text">
             <string>Le fade-in, au début détecté</string>
            </property>
            <property name="buddy">
             <cstring>position_entree</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="position_entree"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="etiquette_position_sortie">
            <property name="text">
             <string>Le fade-out, à la fin détectée</string>
            </property>
            <property name="buddy">
             <cstring>position_sortie</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="position_sortie"/>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QWidget" name="place_demonstration" native="true">
            <property name="toolTip">
             <string>Démonstration : un sonore de 30 s, aux blancs de 3 s au début et 4 s à la fin, retirés à l'antenne, avec les crossfades par défaut saisis</string>
            </property>
            <property name="minimumSize">
             <size>
              <width>360</width>
              <height>72</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QLabel" name="legende_demonstration">
            <property name="text">
             <string/>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="explication">
         <property name="text">
          <string>Les fiches ouvertes ensuite suivent ces réglages. Machin lecture prend les durées par défaut à son prochain démarrage.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_interface">
      <attribute name="title">
       <string>Interface</string>
      </attribute>
      <layout class="QVBoxLayout" name="disposition_interface">
       <item>
        <widget class="QGroupBox" name="groupe_accueil">
         <property name="title">
          <string>Accueil</string>
         </property>
         <layout class="QVBoxLayout" name="disposition_accueil">
          <item>
           <widget class="QCheckBox" name="saturation">
            <property name="text">
             <string>Afficher le voyant de saturation de l'accueil</string>
            </property>
            <property name="toolTip">
             <string>Le voyant « Saturation » de la colonne Antenne, au-dessus du VU-mètre ; le VU-mètre montre toujours les crêtes.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="suggestions">
            <property name="text">
             <string>Proposer au lancement ce qui manque pour démarrer</string>
            </property>
            <property name="toolTip">
             <string>Fil musical, banques de base et périphérique de l'antenne, dans une fenêtre au lancement de l'interface.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupe_icone">
         <property name="title">
          <string>Icône de l'application</string>
         </property>
         <property name="toolTip">
          <string>L'icône des fenêtres de MachinCast, de son raccourci dans le menu des applications et sur le bureau, et de la barre des tâches.</string>
         </property>
         <layout class="QVBoxLayout" name="disposition_icone">
          <item>
           <layout class="QHBoxLayout" name="ligne_icone" stretch="0,1,0,0">
            <item>
             <widget class="QLabel" name="icone_apercu">
              <property name="minimumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
              <property name="maximumSize">
               <size>
                <width>48</width>
                <height>48</height>
               </size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="icone_chemin">
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="textInteractionFlags">
               <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="choisir_icone">
              <property name="text">
               <string>&amp;Choisir une image…</string>
              </property>
              <property name="toolTip">
               <string>Une image SVG, PNG ou JPEG, de préférence carrée</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="icone_par_defaut">
              <property name="text">
               <string>Icône de MachinCast</string>
              </property>
              <property name="toolTip">
               <string>Revenir à l'icône de MachinCast</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="icone_erreur">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_audio">
      <attribute name="title">
       <string>Audio</string>
      </attribute>
      <layout class="QVBoxLayout" name="disposition_audio">
       <item>
        <widget class="QGroupBox" name="groupe_peripheriques">
         <property name="title">
          <string>Périphériques</string>
         </property>
         <layout class="QFormLayout" name="formulaire_peripheriques">
          <item row="0" column="0">
           <widget class="QLabel" name="etiquette_antenne">
            <property name="text">
             <string>&amp;Antenne</string>
            </property>
            <property name="buddy">
             <cstring>antenne</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="antenne">
            <property name="toolTip">
             <string>Le périphérique sur lequel Machin lecture diffuse l'antenne</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="etiquette_preecoute">
            <property name="text">
             <string>&amp;Pré-écoute</string>
            </property>
            <property name="buddy">
             <cstring>preecoute</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="preecoute">
            <property name="toolTip">
             <string>Le périphérique de la pré-écoute de l'interface, jamais celui de l'antenne</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="explication_audio">
         <property name="text">
          <string>Machin lecture prend le périphérique de l'antenne à son prochain démarrage ; sans lui, il refuse de diffuser. La pré-écoute ne peut jamais utiliser le périphérique de l'antenne : chacun est grisé dans l'autre choix.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupe_blancs">
         <property name="title">
          <string>Détection de blanc</string>
         </property>
         <layout class="QFormLayout" name="formulaire_blancs">
          <item row="0" column="0">
           <widget class="QLabel" name="etiquette_seuil_blancs">
            <property name="text">
             <string>&amp;Seuil de blanc</string>
            </property>
            <property name="buddy">
             <cstring>seuil_blancs</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="seuil_blancs">
            <property name="toolTip">
             <string>Niveau crête sous lequel le début et la fin d'un sonore sont un blanc ; 0 dB est la pleine échelle</string>
            </property>
            <property name="suffix">
             <string> dB</string>
            </property>
            <property name="decimals">
             <number>1</number>
            </property>
            <property name="minimum">
             <double>-100.0</double>
            </property>
            <property name="maximum">
             <double>-0.1</double>
            </property>
            <property name="singleStep">
             <double>1.0</double>
            </property>
            <property name="value">
             <double>-40.0</double>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="explication_blancs">
         <property name="text">
          <string>L'audit complet mesure les blancs au début et à la fin de chaque fichier à ce seuil ; un nouveau seuil vaut pour les audits suivants. Une banque, ou un sonore, choisit d'être joué sans ses blancs.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="espace_audio">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="page_base">
      <attribute name="title">
       <string>Base</string>
      </attribute>
      <layout class="QVBoxLayout" name="disposition_base">
       <item>
        <layout class="QFormLayout" name="formulaire_base">
         <item row="0" column="0">
          <widget class="QLabel" name="etiquette_peremption">
           <property name="text">
            <string>&amp;Durée de péremption</string>
           </property>
           <property name="buddy">
            <cstring>peremption</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="peremption">
           <property name="suffix">
            <string> jours</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>3650</number>
           </property>
           <property name="value">
            <number>60</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="explication_peremption">
         <property name="text">
          <string>Machin purge efface de la base les passages de l'airplay et les lignes du log plus vieux que cette durée, et les sonores, banques, séquences et événements supprimés depuis plus longtemps. Il ne touche jamais aux fichiers sonores.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="espace_base">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="boutons">
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
