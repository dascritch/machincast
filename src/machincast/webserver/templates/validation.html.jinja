{#- La page de la validation (https://github.com/dascritch/machincast/issues/539) : le code donné au pupitre, ou celui de
    l'application d'authentification (https://github.com/dascritch/machincast/issues/601), et ce qui a refusé le
    précédent ; sans code à saisir, elle se relit jusqu'à ce que le pupitre accepte la connexion
    (https://github.com/dascritch/machincast/issues/600). -#}
{% extends "page.html.jinja" %}
{% block head %}
{% if not field %}
<meta http-equiv="refresh" content="5">
{% endif %}
{{ head }}
{% endblock %}
{% block body %}
<h1>{{ title }}</h1>
<p>{{ explanation }}</p>
{% if field %}
<form method="post" action="/validation">
<p><label>{{ field }}<br><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus></label></p>
<p><button type="submit">{{ _("Validate") }}</button></p>
</form>
{% endif %}
{% if message %}
<p role="alert">{{ message }}</p>
{% endif %}
<form method="post" action="/logout"><p><button type="submit">{{ _("Disconnect") }}</button></p></form>
{% endblock %}
